{
  "name": "amaro-inventory",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "precdk": "tsc -p tsconfig.build.json",
    "cdk": "npm run precdk && cdk --app \"node build/bin/app.js\"",
    "cdk:synth": "npm run precdk && cdk synth --app \"node build/bin/app.js\"",
    "cdk:deploy": "npm run precdk && cdk deploy --app \"node build/bin/app.js\" --all"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1125.0",
    "@aws-sdk/client-rekognition": "^3.1126.0",
    "@aws-sdk/client-s3": "^3.1125.0",
    "@aws-sdk/client-translate": "^3.1126.0",
    "@aws-sdk/lib-dynamodb": "^3.1125.0",
    "@aws-sdk/s3-request-presigner": "^3.1125.0",
    "aws-cdk-lib": "^2.268.0",
    "constructs": "^10.8.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^26.4.1",
    "@types/source-map-support": "^0.5.10",
    "@vitejs/plugin-vue": "^6.0.8",
    "esbuild": "^0.28.2",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  }
}
