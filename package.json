{
  "name": "amaro-inventory",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "cdk": "cdk --app \"node --loader ts-node/esm ./bin/app.ts\"",
    "cdk:synth": "cdk synth --app \"node --loader ts-node/esm ./bin/app.ts\"",
    "cdk:deploy": "cdk deploy --app \"node --loader ts-node/esm ./bin/app.ts\" --all"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1124.0",
    "@aws-sdk/lib-dynamodb": "^3.1124.0",
    "aws-cdk-lib": "^2.267.0",
    "constructs": "^10.8.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^26.4.1",
    "@types/source-map-support": "^0.5.10",
    "@vitejs/plugin-vue": "^6.0.8",
    "esbuild": "^0.28.2",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  }
}
